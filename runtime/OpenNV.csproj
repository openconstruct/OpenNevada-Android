<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Godot 4.7.2's non-Gradle Android template requires this framework. -->
    <TargetFramework Condition="'$(GodotTargetPlatform)' == 'android'">net9.0</TargetFramework>
    <!-- Keep the signed development package, but optimize its Android C# code. -->
    <Optimize Condition="'$(GodotTargetPlatform)' == 'android'">true</Optimize>
    <AssemblyName>OpenNV</AssemblyName>
    <RootNamespace>OpenNV</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-default</AnalysisLevel>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tools\OpenNV.ResourceProbe\**\*.cs" />
    <Compile Remove="tools\NativeStackStartupAudit\**\*.cs" />
    <Compile Remove="tools\ParityRetailPublisher\**\*.cs" />
    <Compile Remove="tools\ParityLiveComparator\**\*.cs" />
  </ItemGroup>
</Project>
